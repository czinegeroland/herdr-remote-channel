# Rust build output
/target/
**/*.rs.bk
*.pdb

# cargo-dist output
/dist/

# The development build of the binary. `cargo install --root .` writes it;
# the README's local development flow runs it through the npm shim.
/bin/

# What the plugin's build step installs, and the development link that
# stands in for it in a source checkout.
/node_modules/

# Coverage and profiling
*.profraw
*.profdata
/coverage/

# Local HRC state. Never commit keys, databases, or decrypted content.
/.hrc/
*.hrc-state
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Secrets and credentials. See PRD sections 14.1, 20.2, and 29.
*.age
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
/tmp/
/scratch/
*.log

# Python bytecode. `scripts/e2e/trusted-call.py` is run directly and imports
# nothing, but running it through `py_compile` to check syntax leaves a
# `__pycache__` beside it, and one of those reached a commit.
__pycache__/
*.pyc
